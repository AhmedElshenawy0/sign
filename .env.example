# Next.js (rewrites + JWT cookie check)
API_INTERNAL_URL=http://127.0.0.1:4000
API_PROXY_TARGET=http://127.0.0.1:4000
JWT_SECRET=change-this-to-a-long-random-string

# Public site content source: sanity | api
# api (or unset) = existing Express/Prisma backend
# sanity = Sanity first, then Express, then dummyData
CONTENT_SOURCE=sanity

# Sanity (create a project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Optional. Needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Optional. Only for `npm run sanity:seed`
SANITY_API_WRITE_TOKEN=

# Cloudinary widget / URL helper for Studio (never put API secret here)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
